# ComfyUI-Roundabout 网关配置模板
# 复制为 .env 后按需修改；gateway/config.py 启动时自动读取（同名环境变量优先）。
# .env 已被 .gitignore 忽略，不要把它提交到版本库。

# ---- MCP 网关（默认开启）----
# 启用 MCP 网关（嵌入 ComfyUI 进程，与 REST 网关共享 task_store / registry / ComfyClient）。
# 默认即为 true，无需在此重复声明；本行保留只为方便改成 false。
# 关掉可省去 mcp / uvicorn 两个依赖，REST 网关不受影响。
MCP_ENABLED=true

# 共享端口：MCP 端点 /mcp 挂在 ComfyUI 同一端口（如 http://127.0.0.1:8188/mcp）
# false 时客户端直连 MCP_HOST:MCP_PORT
MCP_SHARE_PORT=true

# 内部回环后端端口/路径（共享端口模式下仅本机可达，外部不可直达）。
# 端口留空/0（默认）= 由操作系统分配空闲端口：同一台机器同时跑多个 ComfyUI 实例
# （各自 --port 不同）时，各实例的 MCP 后端互不抢端口。实际端口见启动日志。
# 只有需要固定端口（跨机直连、防火墙放行）时才填具体值。
MCP_PORT=0
MCP_PATH=/mcp

# 固定端口映射：按「ComfyUI 端口 -> Roundabout 端口」成对书写，顺序敏感。
# 启动时按本实例的 ComfyUI 端口取其对应的那个端口来绑定：
#   --port 8188 的实例用 888，--port 8189 的实例用 999，同机多开互不干扰。
# 未命中映射的端口回落到系统分配；显式填了 MCP_PORT 时以 MCP_PORT 为准。
# MCP_PORT_MAP=[8188,888],[8189,999]

# 无状态 MCP（默认）：每个请求独立处理、不跟踪会话，ComfyUI 重启后 agent 不必重新 initialize
# （旧 session id 被整个忽略，不再撞 `Session not found`）。默认即为 true，本行保留只为方便改成 false。
# 想换回有状态模式（false）也就是想要「异步任务完成通知」的推送通道——通知挂在会话上。
# 代价：ComfyUI 一重启旧会话全失效，客户端没重新握手之前所有工具调用都报错。
MCP_STATELESS=true

# ---- 常用可选项（不填走默认值，完整清单见 API.md 的「环境变量」表）----
# 默认模型（等价于 models.yaml 的 default_model，环境变量优先级更高）
# DEFAULT_MODEL=z-image-turbo
# 鉴权：填了 key 才会启用（多个用逗号分隔）；不填则 REST/MCP 无需鉴权
# OPENAI_GATEWAY_API_KEYS=
# OPENAI_GATEWAY_AUTH_REQUIRED=true
# 产物 url 绝对化的公开基准地址（部署在别的机器上时必填，如 http://192.168.1.10:8188）
# PUBLIC_BASE_URL=
# 并发生成上限 / 单任务超时（秒）/ url 产物存活期（秒）
# MAX_CONCURRENCY=2
# JOB_TIMEOUT=300
# OUTPUT_TTL=3600
